        cout << "❌ Invalid algorithm choice.\n";

        return;

    }



    int columnIndex = fieldChoice - 1;



    auto start = chrono::high_resolution_clock::now();



    switch (algoChoice) {

        case 1:

            bubbleSort(records, columnIndex);

            cout << "✅ Records sorted using Bubble Sort.\n";

