void merge(vector<vector<string>>& records, int left, int mid, int right, int fieldIndex) {

    vector<vector<string>> leftVec(records.begin() + left, records.begin() + mid + 1);

    vector<vector<string>> rightVec(records.begin() + mid + 1, records.begin() + right + 1);



    int i = 0, j = 0, k = left;



    while (i < leftVec.size() && j < rightVec.size()) {

        if (leftVec[i][fieldIndex] <= rightVec[j][fieldIndex]) {

            records[k++] = leftVec[i++];

        } else {

            records[k++] = rightVec[j++];

        }

    }



    while (i < leftVec.size()) records[k++] = leftVec[i++];

    while (j < rightVec.size()) records[k++] = rightVec[j++];

}

void mergeSort(vector<vector<string>>& records, int left, int right, int fieldIndex) {

    if (left < right) {

        int mid = left + (right - left) / 2;

        mergeSort(records, left, mid, fieldIndex);

        mergeSort(records, mid + 1, right, fieldIndex);

        merge(records, left, mid, right, fieldIndex);

    }

}

void insertionSort(vector<vector<string>>& records, int fieldIndex) {

    for (size_t i = 1; i < records.size(); ++i) {

        auto key = records[i];

        int j = i - 1;

        while (j >= 0 && records[j][fieldIndex] > key[fieldIndex]) {

            records[j + 1] = records[j];

            j--;

        }

        records[j + 1] = key;

    }

}

