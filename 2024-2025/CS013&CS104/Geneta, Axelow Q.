string selectCourseYear() {

    vector<string> courses = {"BSCS", "BSIT", "BSIS", "BSCE"};

    vector<string> years = {"1st Year", "2nd Year", "3rd Year", "4th Year"};



    int courseChoice = 0;

    int yearChoice = 0;

    const int maxAttempts = 3;



    // Select Course with up to 3 attempts

    for (int attempt = 1; attempt <= maxAttempts; ++attempt) {

        cout << "\n-------------------\n";

        cout << "   Select Course\n";

        cout << "-------------------\n";

        for (size_t i = 0; i < courses.size(); ++i) {

            cout << i + 1 << ". " << courses[i] << '\n';

        }

        cout << "Enter your course choice: ";

        cin >> courseChoice;



        if (courseChoice >= 1 && courseChoice <= (int)courses.size()) {

            cin.ignore(numeric_limits<streamsize>::max(), '\n');  // flush newline

            break;  // valid input, exit loop

        } else {

            cout << "❌ Invalid course selection. Attempts left: " << maxAttempts - attempt << "\n";

            cin.clear();  // clear error flags

            cin.ignore(numeric_limits<streamsize>::max(), '\n');  // flush bad input

            if (attempt == maxAttempts) return "";  // cancel after 3 attempts

        }

    }



    // Select Year with up to 3 attempts

    for (int attempt = 1; attempt <= maxAttempts; ++attempt) {

        cout << "\n-------------------\n";

        cout << "      Select Year\n";

        cout << "-------------------\n";

        for (size_t i = 0; i < years.size(); ++i) {

            cout << i + 1 << ". " << years[i] << '\n';

        }

        cout << "Enter your year choice: ";

        cin >> yearChoice;



        if (yearChoice >= 1 && yearChoice <= (int)years.size()) {

            cin.ignore(numeric_limits<streamsize>::max(), '\n');  // flush newline

            break;  // valid input, exit loop

        } else {

            cout << "❌ Invalid year level selection. Attempts left: " << maxAttempts - attempt << "\n";

            cin.clear();

            cin.ignore(numeric_limits<streamsize>::max(), '\n');

            if (attempt == maxAttempts) return "";  // cancel after 3 attempts

        }

    }



    return courses[courseChoice - 1] + " " + years[yearChoice - 1];

}

