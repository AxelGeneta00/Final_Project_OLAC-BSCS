bool isValidName(const string& name) {

    if (name.empty()) return false;

    for (char c : name) {

        if (isdigit(c)) return false;  // no digits allowed

    }

    return true;

}

bool isValidAge(const string& age) {

    if (age.empty() || age.length() > 2) return false;



    for (char c : age) {

        if (!isdigit(c)) return false;  // all chars must be digits

    }



    return true;

}

bool isValidPhone(const string& phone) {

    if (phone.length() < 10 || phone.length() > 11) return false;

    for (char c : phone) {

        if (!isdigit(c)) return false;

    }

    return true;

}

bool isValidEmail(const string& email) {

    regex pattern(R"((\w+)(\.|_)?(\w*)@(\w+)(\.(\w+))+)");

    return regex_match(email, pattern);

}

bool isValidStudentID(const string& id) {

    if (id.empty()) return false;



    for (char c : id) {

        if (!isdigit(c)) return false;

    }



    return true;

}

bool isValidContactNumber(const string& number) {

    

    if (number.length() < 10 || number.length() > 13) return false;



    

    for (char c : number) {

        if (!isdigit(c)) return false;

    }



    return true;

}



