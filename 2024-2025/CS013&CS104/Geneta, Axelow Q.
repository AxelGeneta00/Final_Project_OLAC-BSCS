void bubbleSort(vector<vector<string>>& records, int fieldIndex) {

    for (size_t i = 0; i < records.size(); ++i) {

        for (size_t j = 0; j < records.size() - i - 1; ++j) {

            if (records[j][fieldIndex] > records[j + 1][fieldIndex]) {

                swap(records[j], records[j + 1]);

            }

        }

    }

}

void selectionSort(vector<vector<string>>& records, int fieldIndex) {

    for (size_t i = 0; i < records.size(); ++i) {

        size_t minIndex = i;

        for (size_t j = i + 1; j < records.size(); ++j) {

            if (records[j][fieldIndex] < records[minIndex][fieldIndex]) {

                minIndex = j;

            }

        }

        swap(records[i], records[minIndex]);

    }

}

