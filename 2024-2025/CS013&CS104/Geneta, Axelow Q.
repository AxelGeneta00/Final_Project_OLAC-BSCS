        attempts++;

    }

    if (attempts == 3) return;



    // Age

    attempts = 0;

    while (attempts < 3) {

        cout << "\n----------------------------------\n";

        cout << "            Enter Age\n";

        cout << "═----------------------------------\n";

        cout << "Enter Age: ";

        getline(cin, age);

        if (isValidAge(age)) break;

        cout << "❌ Invalid age!\n";

        attempts++;

    }

    if (attempts == 3) return;



    // Gender

    gender = selectGender();

    if (gender.empty()) {

        cout << "❌ Failed to select gender. Cancelling add record.\n";

        return;

    }



    // Course & Year

    courseYear = selectCourseYear();

    if (courseYear.empty()) {

        cout << "❌ Failed to select course/year. Cancelling add record.\n";

        return;

    }



    // Status

    status = selectStatus();

    if (status.empty()) {

        cout << "❌ Failed to select status. Cancelling add record.\n";

        return;

    }



    // Contact

    attempts = 0;

    while (attempts < 3) {

        cout << "\n═----------------------------------═\n";

        cout << "        Enter Contact No.\n";

        cout << "----------------------------------\n";

        cout << "Enter Contact No.: ";

        getline(cin, contact);



        if (!isValidPhone(contact)) {

            cout << "❌ Invalid phone number!\n";

            attempts++;

            continue;

        }



        // Check duplicate contact

        bool duplicate = false;

        for (const auto& record : records) {

            if (record[6] == contact) {

                cout << "\n----------------------------------\n";

                cout << "❌ Duplicate Contact Number found. Record not added.\n";

                cout << "----------------------------------\n";

                cout << "[1] Edit Contact Number\n";

                cout << "[2] Cancel Add Record\n";

                cout << "Enter choice: ";

                int choice = getMenuChoice(1, 2);

                if (choice == 2) return;

                duplicate = true;

                break;

            }

        }



        if (!duplicate) break;

        attempts++;

    }

    if (attempts == 3) return;



    // Email

    cout << "\n----------------------------------\n";

    cout << "    Enter Email Address (optional)\n";

    cout << "----------------------------------\n";

    cout << "Enter Email Address: ";

    getline(cin, email);



    if (!email.empty()) {

        if (!isValidEmail(email)) {

            cout << "❌ Invalid email. Leaving blank.\n";

            email = "";

        } else {

            // Check duplicate email

            for (const auto& record : records) {

                if (record[7] == email) {

                    cout << "\n══════════════════════════════\n";

                    cout << "❌ Duplicate Email Address found. Record not added.\n";

                    cout << "══════════════════════════════\n";

                    cout << "[1] Edit Email Address\n";

                    cout << "[2] Leave Email Blank\n";

                    cout << "Enter choice: ";

                    int choice = getMenuChoice(1, 2);

                    if (choice == 1) {

                        cout << "Enter New Email Address: ";

                        getline(cin, email);

                        if (!isValidEmail(email)) {

                            cout << "❌ Still invalid. Leaving blank.\n";

                            email = "";

                        }

                    } else {

                        email = "";

                    }

                    break;

                }

            }

        }

    }



    // Save record

    records.push_back({studentID, name, age, gender, courseYear, status, contact, email});

    cout << "\n✅ Record added successfully!\n";

}

void deleteRecord(vector<vector<string>>& records) {

    if (records.empty()) {

        cout << "\n📂 No records to delete.\n";

        return;

    }



    displayRecords(records);  // Show current records



    int index;

    cout << "Enter the record number to delete: ";

    cin >> index;



    if (index < 1 || index > records.size()) {

        cout << "❌ Invalid record number.\n";

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        return;

    }



    index--;  // convert to 0-based index



    char confirm;

    cout << "Are you sure you want to delete this record? (y/n): ";

    cin >> confirm;

    cin.ignore(numeric_limits<streamsize>::max(), '\n');



    if (confirm == 'y' || confirm == 'Y') {

        records.erase(records.begin() + index);

        cout << "✅ Record deleted successfully!\n";

    } else {

        cout << "❌ Deletion cancelled.\n";

    }

}

